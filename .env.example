# Location Capture Environment Configuration

# Geograph Britain and Ireland API Key
# Request a free API key at: https://www.geograph.org.uk/get-api-key.php
# Copy this file to .env.local and populate your key:
GEOGRAPH_API_KEY=

# Pexels Official Stock Library API Key (Optional for Stock Photographs & HD Videos)
# Free registration at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Server Port (default 3000)
PORT=3000

